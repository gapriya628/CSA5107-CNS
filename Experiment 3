#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void createMatrix(char key[])
{
    char used[26] = {0};
    char text[100];
    int i, j, k = 0;

    strcpy(text, key);
    strcat(text, "ABCDEFGHIKLMNOPQRSTUVWXYZ");

    for (i = 0; text[i] != '\0'; i++)
    {
        char ch = toupper(text[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }
}

void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            if (matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
            }
}

void encrypt(char text[])
{
    int i, r1, c1, r2, c2;

    for (i = 0; text[i] != '\0'; i += 2)
    {
        findPosition(text[i], &r1, &c1);
        findPosition(text[i + 1], &r2, &c2);

        if (r1 == r2)
        {
            c1 = (c1 + 1) % 5;
            c2 = (c2 + 1) % 5;
        }
        else if (c1 == c2)
        {
            r1 = (r1 + 1) % 5;
            r2 = (r2 + 1) % 5;
        }
        else
        {
            int temp = c1;
            c1 = c2;
            c2 = temp;
        }

        text[i] = matrix[r1][c1];
        text[i + 1] = matrix[r2][c2];
    }
}

int main()
{
    char key[50], text[100];
    int i;

    printf("Enter the keyword: ");
    scanf("%s", key);

    printf("Enter the plaintext: ");
    scanf("%s", text);

    for (i = 0; text[i] != '\0'; i++)
    {
        text[i] = toupper(text[i]);

        if (text[i] == 'J')
            text[i] = 'I';
    }

    if (strlen(text) % 2 != 0)
        strcat(text, "X");

    createMatrix(key);

    printf("\nPlayfair Matrix:\n");

    for (i = 0; i < 5; i++)
    {
        printf("%c %c %c %c %c\n",
               matrix[i][0], matrix[i][1], matrix[i][2],
               matrix[i][3], matrix[i][4]);
    }

    encrypt(text);

    printf("\nEncrypted Text: %s\n", text);

    return 0;
}
