#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create Playfair Matrix */
void createMatrix(char key[])
{
    int used[26] = {0};
    int row = 0, col = 0;

    for (int i = 0; key[i] != '\0'; i++)
    {
        char ch = toupper(key[i]);

        if (ch < 'A' || ch > 'Z')
            continue;

        if (ch == 'J')
            ch = 'I';

        if (!used[ch - 'A'])
        {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;

            if (col == 5)
            {
                col = 0;
                row++;
            }
        }
    }

    for (char ch = 'A'; ch <= 'Z'; ch++)
    {
        if (ch == 'J')
            continue;

        if (!used[ch - 'A'])
        {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;

            if (col == 5)
            {
                col = 0;
                row++;
            }
        }
    }
}

/* Find position of character */
void findPosition(char ch, int *row, int *col)
{
    if (ch == 'J')
        ch = 'I';

    for (int i = 0; i < 5; i++)
    {
        for (int j = 0; j < 5; j++)
        {
            if (matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Decrypt a pair of characters */
void decryptPair(char a, char b, char *x, char *y)
{
    int r1, c1, r2, c2;

    findPosition(a, &r1, &c1);
    findPosition(b, &r2, &c2);

    /* Same row */
    if (r1 == r2)
    {
        *x = matrix[r1][(c1 + 4) % 5];
        *y = matrix[r2][(c2 + 4) % 5];
    }

    /* Same column */
    else if (c1 == c2)
    {
        *x = matrix[(r1 + 4) % 5][c1];
        *y = matrix[(r2 + 4) % 5][c2];
    }

    /* Rectangle rule */
    else
    {
        *x = matrix[r1][c2];
        *y = matrix[r2][c1];
    }
}

int main()
{
    char key[] = "ROYALNEWZEALANDNAVY";

    char ciphertext[] =
        "KXJEYUREBEZWEHEWRYTUHEYFS"
        "KREHEGOYFIWTTTUOLKSYCAJPO"
        "BOTEIZONTXBYBNTGONEYCUZWR"
        "GDSONSXBOUYWRHEBAAHYUSEDQ";

    char plaintext[200];
    int p = 0;

    /* Create Playfair matrix */
    createMatrix(key);

    printf("Playfair Matrix:\n");

    for (int i = 0; i < 5; i++)
    {
        for (int j = 0; j < 5; j++)
        {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    /* Decrypt ciphertext */
    for (int i = 0; ciphertext[i] != '\0'; i += 2)
    {
        decryptPair(ciphertext[i],
                    ciphertext[i + 1],
                    &plaintext[p],
                    &plaintext[p + 1]);

        p += 2;
    }

    plaintext[p] = '\0';

    printf("\nCiphertext:\n%s\n", ciphertext);

    printf("\nDecrypted Message:\n%s\n", plaintext);

    return 0;

